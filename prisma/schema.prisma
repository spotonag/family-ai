// Family AI — local development schema (SQLite).
// Mirrors the entities in the Functional Specification, Section 3.
// Field shapes are written to translate cleanly to Postgres/Supabase later —
// see README.md "Moving to Supabase" for the swap path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Family {
  id        String   @id @default(cuid())
  name      String
  address   String?
  timezone  String   @default("Australia/Sydney")
  createdAt DateTime @default(now())

  profiles       Profile[]
  jobs           Job[]
  shoppingItems  ShoppingItem[]
  dinnerPlans    DinnerPlan[]
  calendarEvents CalendarEvent[]
  feedPosts      FeedPost[]
  announcements  Announcement[]
}

model Profile {
  id          String   @id @default(cuid())
  familyId    String
  name        String
  avatarColor String   @default("#3E7C8C")
  avatarInitial String @default("?")
  // role: "parent" | "child"
  role        String   @default("child")
  createdAt   DateTime @default(now())

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  jobsAssigned  Job[]          @relation("JobAssignee")
  cookedDinners DinnerPlan[]   @relation("DinnerCook")
  dishesDinners DinnerPlan[]   @relation("DinnerDishes")
  events        CalendarEvent[]
  quizResponses QuizResponse[]
  pointsEntries PointsLedger[]
  feedPosts     FeedPost[]
  announcements Announcement[]
  shoppingAdds  ShoppingItem[]
}

model Job {
  id          String    @id @default(cuid())
  familyId    String
  title       String
  assignedToId String?
  points      Int       @default(5)
  estMinutes  Int?
  // status: "open" | "done"
  status      String    @default("open")
  // category: "house" | "farm"
  category    String    @default("house")
  dueDate     DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignedTo Profile? @relation("JobAssignee", fields: [assignedToId], references: [id])
}

model ShoppingItem {
  id        String   @id @default(cuid())
  familyId  String
  name      String
  addedById String?
  // addedVia: "type" | "voice" | "ai"
  addedVia  String   @default("type")
  // status: "pending" | "purchased"
  status    String   @default("pending")
  createdAt DateTime @default(now())

  family  Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  addedBy Profile? @relation(fields: [addedById], references: [id])
}

model DinnerPlan {
  id       String   @id @default(cuid())
  familyId String
  date     DateTime
  mealName String
  cookId   String?
  dishesId String?

  family Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  cook   Profile? @relation("DinnerCook", fields: [cookId], references: [id])
  dishes Profile? @relation("DinnerDishes", fields: [dishesId], references: [id])

  @@unique([familyId, date])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  familyId  String
  title     String
  startTime DateTime
  endTime   DateTime?
  ownerId   String?
  // category: "school" | "sport" | "appointment" | "other"
  category  String   @default("other")

  family Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner  Profile? @relation(fields: [ownerId], references: [id])
}

model QuizQuestion {
  id          String   @id @default(cuid())
  category    String
  question    String
  optionA     String
  optionB     String
  optionC     String
  optionD     String
  // 0=A, 1=B, 2=C, 3=D
  correctIndex Int
  explanation String
  activeDate  DateTime @default(now())
  points      Int      @default(10)

  responses QuizResponse[]
}

model QuizResponse {
  id          String   @id @default(cuid())
  questionId  String
  profileId   String
  chosenIndex Int
  correct     Boolean
  answeredAt  DateTime @default(now())

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  profile  Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([questionId, profileId])
}

model PointsLedger {
  id        String   @id @default(cuid())
  profileId String
  // source: "job" | "quiz" | "bonus"
  source    String
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model FeedPost {
  id          String   @id @default(cuid())
  familyId    String
  authorId    String?
  photoColor  String   @default("#9c6b3d")
  caption     String
  linkedJobId String?
  createdAt   DateTime @default(now())

  family Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author Profile? @relation(fields: [authorId], references: [id])
}

model Announcement {
  id        String   @id @default(cuid())
  familyId  String
  authorId  String?
  text      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  family Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author Profile? @relation(fields: [authorId], references: [id])
}
