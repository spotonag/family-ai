DATABASE_URL="file:./dev.db"
# Unused for sqlite, but Prisma's schema validation requires this to
# resolve to something regardless of provider. See prisma/supabase/README.md
# for what it's actually for once you're on Postgres.
DIRECT_URL="file:./dev.db"

# Optional — set this to switch the AI chat from the rule-based demo parser
# to real Claude. Get a key at https://console.anthropic.com. Leave unset
# and the app falls back to the rule-based parser automatically.
# ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5 if unset.
# ANTHROPIC_MODEL=

# Optional — set this to make Today's Briefing / Weekly Wrap-Up speak with
# a real ElevenLabs voice instead of the browser's built-in one. Get a key
# at https://elevenlabs.io (Profile -> API Keys). Leave unset and it falls
# back to the browser voice automatically.
# ELEVENLABS_API_KEY=

# Optional — defaults to "Hannah", a natural Australian voice. Find other
# voice IDs at https://elevenlabs.io/app/voice-library.
# ELEVENLABS_VOICE_ID=
